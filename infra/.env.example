# Retrainix environment - copy to .env (never commit .env).
# Variables are plan.md section 9, unchanged. Values marked "re-check" must be
# confirmed against the current Gemini API docs once the event project exists.

GCP_PROJECT_ID=retrainix
GCP_REGION=asia-south1     # Mumbai; fallback asia-southeast1 if a GPU/Colab Enterprise feature is missing
GCS_BUCKET=retrainix-data-retrainix
GEMINI_LOCATION=global     # measured 20 Nov: both models answer at global, 404 at asia-south1
GEMINI_API_KEY=            # leave empty when calling Gemini through Vertex AI with the service account
GEMINI_MODEL_BULK=gemini-3.8-flash        # confirmed on Vertex AI 20 Nov (GA)
GEMINI_MODEL_HARD=gemini-3.1-pro-preview  # confirmed on Vertex AI 20 Nov (public preview)
HF_TOKEN=                  # for gated SAM 3 weights
COLAB_RUNTIME_TEMPLATE=
QA_IOU_THRESHOLD=0.75      # suggested default
QA_MAX_RETRIES=2
GEMINI_MAX_CALLS_PER_PROJECT=2000   # suggested default
